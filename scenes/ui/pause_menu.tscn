[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/pause_menu.gd" id="1_pause"]
[ext_resource type="PackedScene" path="res://scenes/ui/options_panel.tscn" id="2_options"]

[node name="PauseMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_pause")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dialog" type="PanelContainer" parent="CenterContainer"]
layout_mode = 2
theme_type_variation = &"Dialog"

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer/Dialog"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="CenterContainer/Dialog/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"DialogTitle"
text = "Pause"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="CenterContainer/Dialog/VBoxContainer"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2
mouse_filter = 2

[node name="ResumeButton" type="Button" parent="CenterContainer/Dialog/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Fortsetzen"

[node name="RestartButton" type="Button" parent="CenterContainer/Dialog/VBoxContainer"]
layout_mode = 2
text = "Neu starten"

[node name="OptionsButton" type="Button" parent="CenterContainer/Dialog/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Optionen"

[node name="MenuButton" type="Button" parent="CenterContainer/Dialog/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"QuietButton"
text = "Hauptmenü"

[node name="Options" parent="." instance=ExtResource("2_options")]
unique_name_in_owner = true
visible = false
layout_mode = 1

[connection signal="pressed" from="CenterContainer/Dialog/VBoxContainer/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="CenterContainer/Dialog/VBoxContainer/OptionsButton" to="." method="_on_options_button_pressed"]
[connection signal="pressed" from="CenterContainer/Dialog/VBoxContainer/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="CenterContainer/Dialog/VBoxContainer/MenuButton" to="." method="_on_menu_button_pressed"]
