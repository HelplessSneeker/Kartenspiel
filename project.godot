; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="kartenspiel"
run/main_scene="uid://bbphe0nc4lheq"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; Reihenfolge ist bedeutsam: Settings legt die Audio-Busse "SFX" und "Music" an,
; die Sfx und Music beim Start fuer ihre Player brauchen. Autoloads werden in
; dieser Reihenfolge geladen.
Settings="*res://settings/settings.gd"
Sfx="*res://audio/sfx_player.gd"
Music="*res://audio/music_player.gd"
; Run haelt den Durchlauf (Deck, Leben, welcher Kampf) ueber den Szenenwechsel
; hinweg. Haengt an keinem der drei oben, die Position ist deshalb frei.
Run="*res://run/run_state.gd"
; Fade blendet zwischen den Bildschirmen. Muss der letzte sein: sein
; CanvasLayer soll ueber allem liegen, und bei gleicher layer-Nummer
; entscheidet die Reihenfolge im Baum - die haengt an der Autoload-Reihenfolge.
Fade="*res://ui/scene_fade.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/game_theme.tres"
theme/default_font_multichannel_signed_distance_field=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-vim/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0784314, 0.0862745, 0.121569, 1)
